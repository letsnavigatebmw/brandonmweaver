---
import Base from '../layouts/Base.astro';
import { roles, advisory, education, person } from '../data/site';
---
<Base title="Experience" description="Experience, advisory roles and education of Brandon M. Weaver: Aperture Hospitality, Navigate, Lacure, Sonder, Stillhouse Spirits, BLKBOX, Bonotel, Diageo, GE and UBS.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow eyebrow--accent">Experience</p>
      <h1 class="display">The Track <em>Record</em></h1>
      <p class="lede">Spirits, luxury hospitality, travel and real estate technology. Founder, COO, CCO, GM and brand marketer.</p>
      <a class="link" href={person.execBio} target="_blank" rel="noopener">Download the executive bio</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="roles">
        {roles.map((r) => (
          <li class="role reveal">
            <div class="role__meta">
              <span class="label num">{r.years}</span>
              <span class="role__place">{r.place}</span>
            </div>
            <div>
              <h2 class="h3 role__co">
                {r.url ? <a href={r.url} target="_blank" rel="noopener">{r.company}</a> : r.company}
              </h2>
              <p class="role__title">{r.title}</p>
              <p class="role__sum">{r.summary}</p>
              {r.bullets.length > 0 && <ul class="role__list">{r.bullets.map((b) => <li>{b}</li>)}</ul>}
              {r.partners && <p class="role__partners"><span class="label">Partners</span> {r.partners}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <div class="reveal">
        <span class="eyebrow">Board & advisory</span>
        <ul class="list">
          {advisory.map((a) => (
            <li>
              <span class="list__t">{a.org}</span>
              <span>{a.role}. {a.note}.</span>
              <span class="label num">{a.years}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <span class="eyebrow">Education</span>
        <ul class="list">
          {education.map((e) => (
            <li>
              <span class="list__t">{e.school}</span>
              <span>{e.degree}</span>
              <span class="label num">{e.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding: clamp(3rem, 7vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem); }
  .page-head .eyebrow { margin: 0 0 1.25rem; }
  .page-head .lede { max-width: 40rem; margin: 1.5rem 0 1.75rem; }
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .role { display: grid; gap: .75rem 3rem; padding: 2.5rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) { .role { grid-template-columns: 4fr 8fr; } }
  .role__meta { display: flex; gap: 1rem; align-items: baseline; }
  @media (min-width: 900px) { .role__meta { flex-direction: column; gap: .35rem; } }
  .role__place { font-size: .875rem; color: var(--ink-3); }
  .role__co { font-size: clamp(1.6rem, 2.4vw, 2rem); }
  .role__co a { text-decoration: none; }
  .role__co a:hover { color: var(--accent); }
  .role__title { margin: .3rem 0 1rem; font-family: var(--serif); font-style: italic; font-size: 1.15rem; color: var(--ink-2); }
  .role__sum { color: var(--ink); max-width: 65ch; }
  .role__list { margin: 0; padding: 0 0 0 1.1rem; display: grid; gap: .6rem; max-width: 68ch; }
  .role__list li::marker { color: var(--accent); }
  .role__partners { margin: 1.25rem 0 0; font-size: .9375rem; color: var(--ink); max-width: 68ch; }
  .role__partners .label { margin-right: .5rem; }
  .two { display: grid; gap: 3.5rem; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .list { list-style: none; padding: 0; margin: 1.25rem 0 0; border-top: 1px solid var(--ink); }
  .list li { display: grid; gap: .25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  .list__t { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); }
</style>
