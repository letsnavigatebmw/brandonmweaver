---
import { person } from '../data/site';
const reasons = ['Executive role', 'Board or advisory seat', 'Aperture engagement', 'Speaking or media', 'Something else'];
---
<section id="contact" class="section">
  <div class="container rail">
    <div class="rail__head reveal">
      <span class="label">Contact</span>
      <h2 class="h2">Let’s talk.</h2>
      <p class="lede" style="margin-top:1.25rem">Executive roles, board seats, advisory work, or a good conversation. I read everything.</p>
      <ul class="direct">
        <li><span class="label">Email</span><a class="link link--plain" href={`mailto:${person.email}`}>{person.email}</a></li>
        <li><span class="label">LinkedIn</span><a class="link link--plain" href={person.linkedin} target="_blank" rel="noopener">in/brandonmweaver</a></li>
        <li><span class="label">Executive bio</span><a class="link link--plain" href={person.execBio} target="_blank" rel="noopener">Download (PDF)</a></li>
      </ul>
    </div>

    <form class="form reveal" action={person.formspree} method="POST" novalidate>
      <div class="row">
        <div class="field">
          <label for="f-first">First name</label>
          <input id="f-first" name="firstName" autocomplete="given-name" required />
        </div>
        <div class="field">
          <label for="f-last">Last name</label>
          <input id="f-last" name="lastName" autocomplete="family-name" required />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-org">Company <span class="opt">optional</span></label>
          <input id="f-org" name="company" autocomplete="organization" />
        </div>
      </div>
      <div class="field">
        <label for="f-reason">What’s this about?</label>
        <select id="f-reason" name="reason" required>
          <option value="">Choose one</option>
          {reasons.map((r) => <option>{r}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="f-msg">Message</label>
        <textarea id="f-msg" name="message" rows="5" required></textarea>
      </div>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <div class="actions">
        <button class="btn" type="submit">Send message</button>
        <p class="status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<style>
  .direct { list-style: none; padding: 0; margin: 2.25rem 0 0; display: grid; gap: 1.1rem; }
  .direct li { display: grid; gap: .2rem; }
  .direct .link { text-decoration-color: var(--rule); word-break: break-word; }
  .form { display: grid; gap: 1.25rem; }
  .row { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: .45rem; }
  label { font-size: .875rem; font-weight: 550; color: var(--ink); }
  .opt { font-weight: 400; color: var(--ink-3); }
  input, select, textarea {
    font: inherit; font-size: 1rem; color: var(--ink); background: transparent;
    border: 0; border-bottom: 1px solid var(--ink-3); border-radius: 0; padding: .6rem 0; width: 100%;
    transition: border-color .2s ease;
  }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink-2) 50%), linear-gradient(135deg, var(--ink-2) 50%, transparent 50%); background-position: calc(100% - 10px) 55%, calc(100% - 5px) 55%; background-size: 5px 5px; background-repeat: no-repeat; cursor: pointer; }
  textarea { resize: vertical; min-height: 120px; }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom: 2px solid var(--accent); }
  [aria-invalid='true'] { border-bottom-color: var(--accent); }
  .hp { position: absolute; left: -9999px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: .5rem; }
  .actions .btn[disabled] { opacity: .55; cursor: wait; }
  .status { margin: 0; font-size: .9375rem; color: var(--ink); }
  .status.is-error { border-left: 2px solid var(--accent); padding-left: .75rem; }
  .status a { color: var(--accent); }
</style>

<script define:vars={{ email: person.email }}>
  const form = document.querySelector('#contact form');
  const status = form.querySelector('.status');
  const btn = form.querySelector('button[type=submit]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    let ok = true;
    form.querySelectorAll('[required]').forEach((el) => {
      const bad = !el.value.trim() || (el.type === 'email' && !/^\S+@\S+\.\S+$/.test(el.value));
      el.setAttribute('aria-invalid', bad ? 'true' : 'false');
      if (bad) ok = false;
    });
    if (!ok) { status.className = 'status is-error'; status.textContent = 'Please fill in the highlighted fields.'; return; }
    btn.disabled = true; btn.textContent = 'Sending…'; status.className = 'status'; status.textContent = '';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Thank you. I’ll be in touch shortly.';
    } catch {
      status.className = 'status is-error';
      status.innerHTML = `That didn’t go through. Please email me directly at <a href="mailto:${email}">${email}</a>.`;
    } finally {
      btn.disabled = false; btn.textContent = 'Send message';
    }
  });
</script>
